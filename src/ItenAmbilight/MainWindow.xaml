<Window x:Class="ItenAmbilight.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IT-EN Ambilight" Width="1240" Height="820" MinWidth="1040" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13.5" UseLayoutRounding="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="3"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Background="{StaticResource RgbBrush}"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="PreviewColumn" Width="0"/>
            </Grid.ColumnDefinitions>

            <!-- ================= Seitenleiste ================= -->
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
                <DockPanel Margin="12,18,12,14">
                    <Border DockPanel.Dock="Bottom" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="ConnDot" Width="8" Height="8" Fill="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock x:Name="ConnText" Text="Nicht verbunden" FontWeight="SemiBold" FontSize="13"/>
                            </StackPanel>
                            <TextBlock x:Name="ConnSub" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="IT-EN AMBILIGHT" FontWeight="Bold" FontSize="13" Margin="14,0,0,16"/>
                        <RadioButton x:Name="NavStart" Style="{StaticResource NavItem}" Content="Start" IsChecked="True"/>
                        <RadioButton x:Name="NavEffects" Style="{StaticResource NavItem}" Content="Effekte"/>
                        <RadioButton x:Name="NavEditor" Style="{StaticResource NavItem}" Content="Eigene Effekte"/>
                        <RadioButton x:Name="NavRules" Style="{StaticResource NavItem}" Content="Regeln"/>
                        <RadioButton x:Name="NavAuto" Style="{StaticResource NavItem}" Content="Automatik"/>
                        <RadioButton x:Name="NavDevice" Style="{StaticResource NavItem}" Content="Gerät"/>
                        <TextBlock Text="EINSTELLUNGEN" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold" Margin="14,16,0,8"/>
                        <RadioButton x:Name="NavHardware" Style="{StaticResource NavItem}" Content="LED-Hardware"/>
                        <RadioButton x:Name="NavAmbilight" Style="{StaticResource NavItem}" Content="Ambilight"/>
                        <RadioButton x:Name="NavControl" Style="{StaticResource NavItem}" Content="Steuerung"/>
                        <RadioButton x:Name="NavGeneral" Style="{StaticResource NavItem}" Content="Allgemein"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ================= Inhalt ================= -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Margin="30,24,30,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="PageTitle" Style="{StaticResource H1}" Text="Start"/>
                        <TextBlock x:Name="StatusText" Style="{StaticResource Muted}" FontSize="13.5" Margin="0,4,0,0"/>
                    </StackPanel>
                    <ToggleButton x:Name="PreviewToggle" Grid.Column="1" Content="Vorschau" VerticalAlignment="Top" MinHeight="40"
                                  ToolTip="Klappt die Vorschau rechts aus. Eingeklappt braucht sie keine Leistung."/>
                </Grid>

                <!-- ============ Seite: Start ============ -->
                <ScrollViewer x:Name="PageStart" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="30,0,18,20">
                        <UniformGrid Columns="4">
                            <RadioButton x:Name="ModeAmbilight" Style="{StaticResource ModeCard}">
                                <StackPanel>
                                    <Border Height="8" CornerRadius="4" Margin="0,0,0,10">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#2A6BFF" Offset="0"/>
                                                <GradientStop Color="#35D0F2" Offset="0.4"/>
                                                <GradientStop Color="#3DE08A" Offset="0.7"/>
                                                <GradientStop Color="#F5E14B" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <TextBlock Text="Ambilight" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" Text="LEDs folgen dem Bildschirm."/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="ModeEffect" Style="{StaticResource ModeCard}">
                                <StackPanel>
                                    <Border Height="8" CornerRadius="4" Margin="0,0,0,10" Background="{StaticResource RgbBrush}"/>
                                    <TextBlock Text="Effekt" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="ModeEffectText" Style="{StaticResource Muted}" Margin="0,6,0,0" Text="Lichteffekt ohne Bildschirm."/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="ModeColor" Style="{StaticResource ModeCard}">
                                <StackPanel>
                                    <Border x:Name="ModeColorStrip" Height="8" CornerRadius="4" Margin="0,0,0,10" Background="#FF9A3D"/>
                                    <TextBlock Text="Feste Farbe" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" Text="Eine Farbe auf allen LEDs."/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="ModeOff" Style="{StaticResource ModeCard}">
                                <StackPanel>
                                    <Border Height="8" CornerRadius="4" Margin="0,0,0,10" Background="#3A4156"/>
                                    <TextBlock Text="Aus" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" Text="LEDs dunkel, Programm läuft weiter."/>
                                </StackPanel>
                            </RadioButton>
                        </UniformGrid>

                        <Border Style="{StaticResource Card}" Margin="0,0,12,14">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="Schnellzugriff"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="56"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Label}" Text="Helligkeit"/>
                                    <Slider x:Name="BrightSlider" Grid.Column="1" Minimum="0" Maximum="100"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource Value}" Text="{Binding Value, ElementName=BrightSlider, StringFormat={}{0:0} %}"/>
                                </Grid>

                                <!-- nur bei Betriebsart Effekt sichtbar -->
                                <Grid x:Name="PanelEffect" Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Label}" Text="Effekt"/>
                                    <DockPanel Grid.Column="1" Margin="0,3,0,3">
                                        <Button x:Name="GotoEffectsButton" DockPanel.Dock="Right" Content="Effekt wählen und einstellen"/>
                                        <TextBlock x:Name="EffectNameText" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    </DockPanel>
                                </Grid>

                                <!-- nur bei Betriebsart Feste Farbe sichtbar -->
                                <Grid x:Name="PanelColor" Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Label}" Text="Farbe"/>
                                    <DockPanel Grid.Column="1" Margin="0,3,0,3">
                                        <Button x:Name="StaticColorButton" DockPanel.Dock="Right" Content="Wählen" Margin="8,0,0,0"/>
                                        <Border x:Name="StaticColorSwatch" DockPanel.Dock="Right" Width="36" CornerRadius="8" Margin="8,0,0,0" BorderBrush="{StaticResource Line2Brush}" BorderThickness="1"/>
                                        <TextBox x:Name="StaticColorBox" ToolTip="Farbe als #RRGGBB"/>
                                    </DockPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <UniformGrid Columns="4">
                            <Border Style="{StaticResource Tile}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Muted}" Text="Bildrate"/>
                                    <TextBlock x:Name="FpsText" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,0" Text="–"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Tile}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Muted}" Text="Prozessor (dieses Programm)"/>
                                    <TextBlock x:Name="CpuText" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,0" Text="–"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Tile}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Muted}" Text="Grafikkarte (dieses Programm)"/>
                                    <TextBlock x:Name="GpuText" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,0" Text="–"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Tile}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Muted}" Text="Arbeitsspeicher"/>
                                    <TextBlock x:Name="RamText" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,0" Text="–"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ Seite: Effekte ============ -->
                <Grid x:Name="PageEffects" Grid.Row="1" Visibility="Collapsed" Margin="30,0,18,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="310"/>
                    </Grid.ColumnDefinitions>
                    <DockPanel Margin="0,0,14,0">
                        <WrapPanel x:Name="CategoryPanel" DockPanel.Dock="Top" Margin="0,0,0,6"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ListBox x:Name="EffectList">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Width="166">
                                            <Border Height="52" CornerRadius="8" Background="{Binding Brush}"/>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="2,9,0,0" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Category}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="2,2,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </ScrollViewer>
                    </DockPanel>

                    <Border Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Top">
                        <StackPanel>
                            <Border x:Name="FxPreview" Height="12" CornerRadius="6" Margin="0,0,0,12"/>
                            <TextBlock x:Name="FxTitle" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock x:Name="FxCategory" Style="{StaticResource Muted}" Margin="0,2,0,12"/>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Value}" Text="{Binding Value, ElementName=FxSpeedSlider, StringFormat={}{0:0}}"/>
                                <TextBlock Text="Geschwindigkeit"/>
                            </DockPanel>
                            <Slider x:Name="FxSpeedSlider" Minimum="1" Maximum="100"/>
                            <DockPanel Margin="0,6,0,0">
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Value}" Text="{Binding Value, ElementName=FxIntensitySlider, StringFormat={}{0:0}}"/>
                                <TextBlock Text="Stärke" ToolTip="Je nach Effekt: Dichte, Breite oder Anzahl"/>
                            </DockPanel>
                            <Slider x:Name="FxIntensitySlider" Minimum="1" Maximum="100"/>
                            <StackPanel x:Name="FxColor1Panel" Margin="0,8,0,0">
                                <TextBlock Text="Farbe 1" Margin="0,0,0,6"/>
                                <DockPanel>
                                    <Button x:Name="FxColor1Button" DockPanel.Dock="Right" Content="Wählen" Margin="8,0,0,0"/>
                                    <Border x:Name="FxColor1Swatch" DockPanel.Dock="Right" Width="36" CornerRadius="8" Margin="8,0,0,0" BorderBrush="{StaticResource Line2Brush}" BorderThickness="1"/>
                                    <TextBox x:Name="FxColor1Box"/>
                                </DockPanel>
                            </StackPanel>
                            <StackPanel x:Name="FxColor2Panel" Margin="0,8,0,0">
                                <TextBlock Text="Farbe 2" Margin="0,0,0,6"/>
                                <DockPanel>
                                    <Button x:Name="FxColor2Button" DockPanel.Dock="Right" Content="Wählen" Margin="8,0,0,0"/>
                                    <Border x:Name="FxColor2Swatch" DockPanel.Dock="Right" Width="36" CornerRadius="8" Margin="8,0,0,0" BorderBrush="{StaticResource Line2Brush}" BorderThickness="1"/>
                                    <TextBox x:Name="FxColor2Box"/>
                                </DockPanel>
                            </StackPanel>
                            <StackPanel x:Name="FxColor3Panel" Margin="0,8,0,0">
                                <TextBlock Text="Farbe 3" Margin="0,0,0,6"/>
                                <DockPanel>
                                    <Button x:Name="FxColor3Button" DockPanel.Dock="Right" Content="Wählen" Margin="8,0,0,0"/>
                                    <Border x:Name="FxColor3Swatch" DockPanel.Dock="Right" Width="36" CornerRadius="8" Margin="8,0,0,0" BorderBrush="{StaticResource Line2Brush}" BorderThickness="1"/>
                                    <TextBox x:Name="FxColor3Box"/>
                                </DockPanel>
                            </StackPanel>
                            <Button x:Name="FxResetButton" Content="Standardwerte" Margin="0,16,0,0"/>
                            <TextBlock x:Name="FxError" Foreground="OrangeRed" TextWrapping="Wrap" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ============ Seite: Eigene Effekte ============ -->
                <Grid x:Name="PageEditor" Grid.Row="1" Visibility="Collapsed" Margin="30,0,18,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="310"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,14,0">
                        <StackPanel>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource H2}" Text="Meine Effekte"/>
                                    <ComboBox x:Name="CustomBox"/>
                                    <UniformGrid Columns="2" Margin="0,8,0,0">
                                        <Button x:Name="CustomNewButton" Content="Neu" Margin="0,0,4,0"/>
                                        <Button x:Name="CustomDeleteButton" Content="Löschen" Margin="4,0,0,0"/>
                                    </UniformGrid>
                                    <TextBlock Text="Name" Margin="0,14,0,6"/>
                                    <TextBox x:Name="CustomNameBox"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource H2}" Text="Baukasten (ohne Code)"/>
                                    <TextBlock Text="Grundlage" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="BuildBaseBox" SelectedIndex="1">
                                        <ComboBoxItem Content="Eine Farbe" Tag="solid"/>
                                        <ComboBoxItem Content="Verlauf aus zwei Farben" Tag="gradient2"/>
                                        <ComboBoxItem Content="Verlauf aus drei Farben" Tag="gradient3"/>
                                        <ComboBoxItem Content="Regenbogen" Tag="rainbow"/>
                                    </ComboBox>
                                    <TextBlock Text="Bewegung" Margin="0,12,0,6"/>
                                    <ComboBox x:Name="BuildMotionBox" SelectedIndex="2">
                                        <ComboBoxItem Content="Keine" Tag="none"/>
                                        <ComboBoxItem Content="Farben drehen sich" Tag="rotate"/>
                                        <ComboBoxItem Content="Helligkeitswellen" Tag="wave"/>
                                        <ComboBoxItem Content="Atmen" Tag="breathe"/>
                                        <ComboBoxItem Content="Lauflicht" Tag="comet"/>
                                    </ComboBox>
                                    <DockPanel Margin="0,12,0,0">
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Value}" Text="{Binding Value, ElementName=BuildWavesSlider, StringFormat={}{0:0}}"/>
                                        <TextBlock Text="Anzahl Wellen"/>
                                    </DockPanel>
                                    <Slider x:Name="BuildWavesSlider" Minimum="1" Maximum="8" Value="3" IsSnapToTickEnabled="True" TickFrequency="1"/>
                                    <CheckBox x:Name="BuildSparkleBox" Content="Funkeln darüberlegen" Margin="0,8,0,0"/>
                                    <Button x:Name="BuildButton" Content="Skript erzeugen" Margin="0,14,0,0"/>
                                    <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,0"
                                               Text="Der Baukasten schreibt das Skript rechts neu. Farben, Geschwindigkeit und Stärke stellst du danach auf der Seite Effekte ein."/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <DockPanel Grid.Column="1">
                        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                            <Button x:Name="CustomRunButton" DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="Speichern und auf den LEDs zeigen" Margin="8,0,0,0"/>
                            <Button x:Name="CustomSaveButton" DockPanel.Dock="Right" Content="Speichern"/>
                            <TextBlock x:Name="ScriptStatus" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
                        </DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                            <TextBlock Style="{StaticResource Muted}" Text="Live-Vorschau (alle LEDs nebeneinander, ändert sich beim Tippen)" Margin="0,0,0,6"/>
                            <Border x:Name="ScriptPreview" Height="18" CornerRadius="9" Background="{StaticResource InputBrush}"/>
                        </StackPanel>
                        <TextBox x:Name="ScriptBox" Style="{StaticResource CodeBox}"/>
                    </DockPanel>
                </Grid>

                <!-- ============ Seite: Regeln ============ -->
                <ScrollViewer x:Name="PageRules" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <Grid Margin="30,0,18,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="330"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,14,0">
                            <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,14"
                                       Text="Solange ein Programm aus der Liste im Vordergrund ist, gilt seine Regel statt der Betriebsart von der Startseite."/>
                            <ListBox x:Name="RulesList">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="44"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource InputBrush}" HorizontalAlignment="Left">
                                                <Image Source="{Binding Icon}" Width="28" Height="28"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Action}" Foreground="{StaticResource MutedBrush}" FontSize="12.5" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="RulesEmpty" Style="{StaticResource Muted}" Text="Noch keine Regeln. Rechts ein Programm wählen und hinzufügen."/>
                        </StackPanel>

                        <Border Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="Regel bearbeiten"/>
                                <TextBlock Text="Programm" Margin="0,0,0,6"/>
                                <ComboBox x:Name="RuleProcessBox" ToolTip="Laufende Programme mit Fenster"/>
                                <UniformGrid Columns="2" Margin="0,8,0,0">
                                    <Button x:Name="RuleRefreshButton" Content="Neu einlesen" Margin="0,0,4,0"/>
                                    <Button x:Name="RuleBrowseButton" Content=".exe suchen" Margin="4,0,0,0"/>
                                </UniformGrid>
                                <TextBlock Text="Dann" Margin="0,14,0,6"/>
                                <ComboBox x:Name="RuleModeBox" SelectedIndex="0">
                                    <ComboBoxItem Content="LEDs aus" Tag="off"/>
                                    <ComboBoxItem Content="Effekt" Tag="effect"/>
                                    <ComboBoxItem Content="Feste Farbe" Tag="color"/>
                                    <ComboBoxItem Content="Ambilight (Bildschirm)" Tag="ambilight"/>
                                </ComboBox>
                                <StackPanel x:Name="RuleEffectPanel">
                                    <TextBlock Text="Effekt" Margin="0,14,0,6"/>
                                    <ComboBox x:Name="RuleEffectBox"/>
                                </StackPanel>
                                <StackPanel x:Name="RuleColorPanel">
                                    <TextBlock Text="Farbe" Margin="0,14,0,6"/>
                                    <DockPanel>
                                        <Button x:Name="RuleColorButton" DockPanel.Dock="Right" Content="Wählen" Margin="8,0,0,0"/>
                                        <Border x:Name="RuleColorSwatch" DockPanel.Dock="Right" Width="36" CornerRadius="8" Margin="8,0,0,0" BorderBrush="{StaticResource Line2Brush}" BorderThickness="1"/>
                                        <TextBox x:Name="RuleColorBox" Text="#FFFFFF"/>
                                    </DockPanel>
                                </StackPanel>
                                <Button x:Name="RuleAddButton" Style="{StaticResource AccentButton}" Content="Hinzufügen / ändern" Margin="0,18,0,0"/>
                                <Button x:Name="RuleRemoveButton" Content="Ausgewählte Regel entfernen" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>

                <!-- ============ Seite: Gerät ============ -->
                <ScrollViewer x:Name="PageDevice" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="30,0,18,20">
                        <Border Style="{StaticResource Card}" Margin="0,0,12,14">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="Anschluss"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Label}" Text="Gerät"/>
                                    <ComboBox x:Name="PortBox" Grid.Column="1"/>
                                    <Button x:Name="RefreshPortsButton" Grid.Column="2" Content="Neu suchen" Margin="8,0,0,0"/>
                                </Grid>
                                <TextBlock x:Name="DeviceInfo" Style="{StaticResource Muted}" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,12,14">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="ESP32 und Taster"/>
                                <UniformGrid Columns="4">
                                    <Border Background="{StaticResource Card2Brush}" CornerRadius="10" Padding="12" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Muted}" Text="Zustand am Gerät"/>
                                            <TextBlock x:Name="TelOnText" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,0" Text="–"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{StaticResource Card2Brush}" CornerRadius="10" Padding="12" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Muted}" Text="Dimmstufe am Gerät"/>
                                            <TextBlock x:Name="TelDimText" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,0" Text="–"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{StaticResource Card2Brush}" CornerRadius="10" Padding="12" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Muted}" Text="Chip-Temperatur"/>
                                            <TextBlock x:Name="TelTempText" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,0" Text="–"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{StaticResource Card2Brush}" CornerRadius="10" Padding="12">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Muted}" Text="LED-Leistung, geschätzt"/>
                                            <TextBlock x:Name="TelPowerText" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,0" Text="–"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                                <UniformGrid Columns="2" Margin="0,12,0,0">
                                    <Button x:Name="DeviceToggleButton" Content="Ein / Aus am Gerät umschalten" Margin="0,0,4,0"/>
                                    <Button x:Name="DeviceDimButton" Content="Dimmstufe am Gerät wechseln" Margin="4,0,0,0"/>
                                </UniformGrid>
                                <TextBlock x:Name="TelHint" Style="{StaticResource Muted}" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,12,14">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="Verlauf"/>
                                <ItemsControl x:Name="LogList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3,0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="76"/>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding TimeText}" FontFamily="Consolas" Foreground="{StaticResource MutedBrush}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Source}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Text}" TextWrapping="Wrap"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,12,14">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="Auslastung dieses Programms"/>
                                <TextBlock x:Name="UsageInfo" FontFamily="Consolas" TextWrapping="Wrap" LineHeight="22"/>
                                <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,0"
                                           Text="Die Werte gelten nur für IT-EN Ambilight, nicht für den ganzen PC. Die Grafikkarten-Auslastung kommt aus den Windows-Leistungszählern und kann auf manchen Systemen fehlen."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ Seite: LED-Hardware ============ -->
                <ScrollViewer x:Name="PageHardware" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="30,0,18,20">
                        <Border Style="{StaticResource Card}" Margin="0,0,12,14">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="Aus der Bildschirmgrösse berechnen"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Style="{StaticResource Label}" Text="Diagonale in Zoll"/>
                                    <TextBox x:Name="DiagonalBox" Grid.Column="1" Margin="0,3,0,3"/>
                                    <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="LED-Dichte (LEDs pro Meter)"/>
                                    <TextBox x:Name="DensityBox" Grid.Row="1" Grid.Column="1" Margin="0,3,0,3"/>
                                </Grid>
                                <TextBlock x:Name="SizeInfo" Style="{StaticResource Muted}" Margin="0,10,0,8"/>
                                <CheckBox x:Name="AutoBox" Content="Anzahl automatisch aus der Bildschirmgrösse übernehmen"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,12,14">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="LEDs pro Seite (Ansicht von vorne)"/>
                                <Grid HorizontalAlignment="Left" Width="560">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="170"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                                        <TextBlock Text="Oben" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBox x:Name="TopBox" Width="70" TextAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="Links" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                        <TextBox x:Name="LeftBox" Width="70" TextAlignment="Center"/>
                                    </StackPanel>
                                    <Border Grid.Row="1" Grid.Column="1" CornerRadius="10" Padding="5" Background="{StaticResource RgbBrush}">
                                        <Border CornerRadius="6" Background="{StaticResource BgBrush}">
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock x:Name="TotalInfo" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="320"/>
                                            </StackPanel>
                                        </Border>
                                    </Border>
                                    <StackPanel Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="Rechts" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                        <TextBox x:Name="RightBox" Width="70" TextAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                                        <TextBlock Text="Unten" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBox x:Name="BottomBox" Width="70" TextAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="260"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Label}" Text="Erste LED sitzt"/>
                                    <ComboBox x:Name="StartBox" Grid.Column="1">
                                        <ComboBoxItem Content="unten links"/>
                                        <ComboBoxItem Content="oben links"/>
                                        <ComboBoxItem Content="oben rechts"/>
                                        <ComboBoxItem Content="unten rechts"/>
                                    </ComboBox>
                                </Grid>
                                <CheckBox x:Name="ClockwiseBox" Content="Strip läuft im Uhrzeigersinn" Margin="0,12,0,0"/>
                                <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,0" Text="Tipp: Vorschau ausklappen. Die weiss umrandete LED ist LED 1."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ Seite: Ambilight ============ -->
                <ScrollViewer x:Name="PageAmbilight" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="30,0,18,20">
                        <Border Style="{StaticResource Card}" Margin="0,0,12,14">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="Monitor"/>
                                <DockPanel>
                                    <Button x:Name="IdentifyButton" DockPanel.Dock="Right" Content="Identifizieren" Margin="8,0,0,0"
                                            ToolTip="Blendet auf jedem Monitor kurz seine Nummer ein"/>
                                    <ComboBox x:Name="MonitorBox"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,12,14">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="Bildbereich"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="56"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Style="{StaticResource Label}" Text="Rand links"/>
                                    <Slider x:Name="CropLeftSlider" Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="40"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource Value}" Text="{Binding Value, ElementName=CropLeftSlider, StringFormat={}{0:0} %}"/>
                                    <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Rand rechts"/>
                                    <Slider x:Name="CropRightSlider" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="40"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Value}" Text="{Binding Value, ElementName=CropRightSlider, StringFormat={}{0:0} %}"/>
                                    <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="Rand oben"/>
                                    <Slider x:Name="CropTopSlider" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="40"/>
                                    <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource Value}" Text="{Binding Value, ElementName=CropTopSlider, StringFormat={}{0:0} %}"/>
                                    <TextBlock Grid.Row="3" Style="{StaticResource Label}" Text="Rand unten"/>
                                    <Slider x:Name="CropBottomSlider" Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="40"/>
                                    <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource Value}" Text="{Binding Value, ElementName=CropBottomSlider, StringFormat={}{0:0} %}"/>
                                    <TextBlock Grid.Row="4" Style="{StaticResource Label}" Text="Messtiefe"/>
                                    <Slider x:Name="DepthSlider" Grid.Row="4" Grid.Column="1" Minimum="2" Maximum="30"/>
                                    <TextBlock Grid.Row="4" Grid.Column="2" Style="{StaticResource Value}" Text="{Binding Value, ElementName=DepthSlider, StringFormat={}{0:0} %}"/>
                                    <TextBlock Grid.Row="5" Style="{StaticResource Label}" Text="Glättung"/>
                                    <Slider x:Name="SmoothSlider" Grid.Row="5" Grid.Column="1" Minimum="0" Maximum="95"/>
                                    <TextBlock Grid.Row="5" Grid.Column="2" Style="{StaticResource Value}" Text="{Binding Value, ElementName=SmoothSlider, StringFormat={}{0:0}}"/>
                                    <CheckBox x:Name="BlackbarBox" Grid.Row="6" Grid.ColumnSpan="3" Margin="0,10,0,6"
                                              Content="Schwarze Balken automatisch überspringen"
                                              ToolTip="Überspringt schwarze Balken bei Filmen (21:9) oder 4:3-Bildern."/>
                                    <TextBlock Grid.Row="7" Style="{StaticResource Label}" Text="Schwarz-Schwelle"/>
                                    <Slider x:Name="BlackbarSlider" Grid.Row="7" Grid.Column="1" Minimum="0" Maximum="60"
                                            ToolTip="Bis zu diesem Wert (0–255) gilt ein Bildpunkt als schwarz."/>
                                    <TextBlock Grid.Row="7" Grid.Column="2" Style="{StaticResource Value}" Text="{Binding Value, ElementName=BlackbarSlider, StringFormat={}{0:0}}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,12,14">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,12">
                                    <Button x:Name="CalibrateButton" DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="Kalibrierung starten" Margin="8,0,0,0"/>
                                    <Button x:Name="ResetColorsButton" DockPanel.Dock="Right" Content="Zurücksetzen"/>
                                    <TextBlock Style="{StaticResource H2}" Margin="0" VerticalAlignment="Center" Text="Farbabgleich"/>
                                </DockPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Label}" Text="Abgleich für"/>
                                    <ComboBox x:Name="ProfileBox" Grid.Column="1" ToolTip="Normales Bild und HDR haben je einen eigenen Abgleich. Das Programm wechselt selbst.">
                                        <ComboBoxItem Content="Normales Bild (SDR)" Tag="sdr"/>
                                        <ComboBoxItem Content="HDR" Tag="hdr"/>
                                    </ComboBox>
                                </Grid>
                                <TextBlock x:Name="ProfileInfo" Style="{StaticResource Muted}" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="56"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Style="{StaticResource Label}" Text="Sättigung"/>
                                    <Slider x:Name="SatSlider" Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="200"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource Value}" Text="{Binding Value, ElementName=SatSlider, StringFormat={}{0:0} %}"/>
                                    <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Gamma"/>
                                    <Slider x:Name="GammaSlider" Grid.Row="1" Grid.Column="1" Minimum="1" Maximum="3" SmallChange="0.05" LargeChange="0.1"
                                            ToolTip="1.0 = unverändert. Höher = dunkle Töne dunkler, Farben kräftiger."/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Value}" Text="{Binding Value, ElementName=GammaSlider, StringFormat={}{0:0.00}}"/>
                                    <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="Rot"/>
                                    <Slider x:Name="GainRSlider" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="100"/>
                                    <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource Value}" Text="{Binding Value, ElementName=GainRSlider, StringFormat={}{0:0} %}"/>
                                    <TextBlock Grid.Row="3" Style="{StaticResource Label}" Text="Grün"/>
                                    <Slider x:Name="GainGSlider" Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="100"/>
                                    <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource Value}" Text="{Binding Value, ElementName=GainGSlider, StringFormat={}{0:0} %}"/>
                                    <TextBlock Grid.Row="4" Style="{StaticResource Label}" Text="Blau"/>
                                    <Slider x:Name="GainBSlider" Grid.Row="4" Grid.Column="1" Minimum="0" Maximum="100"/>
                                    <TextBlock Grid.Row="4" Grid.Column="2" Style="{StaticResource Value}" Text="{Binding Value, ElementName=GainBSlider, StringFormat={}{0:0} %}"/>
                                    <TextBlock Grid.Row="5" Style="{StaticResource Label}" Text="Schwarz-Schwelle"/>
                                    <Slider x:Name="BlackLevelSlider" Grid.Row="5" Grid.Column="1" Minimum="0" Maximum="40"
                                            ToolTip="Unter dieser Helligkeit bleiben die LEDs ganz aus (gegen farbiges Glimmen bei fast schwarzem Bild)."/>
                                    <TextBlock Grid.Row="5" Grid.Column="2" Style="{StaticResource Value}" Text="{Binding Value, ElementName=BlackLevelSlider, StringFormat={}{0:0}}"/>
                                    <TextBlock Grid.Row="6" Style="{StaticResource Label}" Text="Testfarbe"/>
                                    <ComboBox x:Name="TestBox" Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,6,0,0" SelectedIndex="0"
                                              ToolTip="Zeigt auf allen LEDs eine feste Farbe. Endet beim Schliessen des Fensters.">
                                        <ComboBoxItem Content="aus (Bildschirm)"/>
                                        <ComboBoxItem Content="Weiss"/>
                                        <ComboBoxItem Content="Rot"/>
                                        <ComboBoxItem Content="Grün"/>
                                        <ComboBoxItem Content="Blau"/>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,12,14">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="HDR"/>
                                <CheckBox x:Name="HdrBox" Content="HDR-Bild aufnehmen, wenn HDR in Windows eingeschaltet ist"/>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="56"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Label}" Text="Weiss bei (nits)"/>
                                    <Slider x:Name="PaperWhiteSlider" Grid.Column="1" Minimum="80" Maximum="480"
                                            ToolTip="Helligkeit, die als normales Weiss gilt. Tiefer = LEDs heller."/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource Value}" Text="{Binding Value, ElementName=PaperWhiteSlider, StringFormat={}{0:0}}"/>
                                </Grid>
                                <TextBlock x:Name="HdrInfo" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,12,14">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="Aufnahme"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="56"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Style="{StaticResource Label}" Text="Bilder pro Sekunde"/>
                                    <Slider x:Name="FpsSlider" Grid.Column="1" Minimum="10" Maximum="144"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource Value}" Text="{Binding Value, ElementName=FpsSlider, StringFormat={}{0:0}}"/>
                                    <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Verfahren"/>
                                    <ComboBox x:Name="CaptureBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4,0,4">
                                        <ComboBoxItem Content="automatisch" Tag="auto"/>
                                        <ComboBoxItem Content="Desktop Duplication (schnell)" Tag="dxgi"/>
                                        <ComboBoxItem Content="GDI (Rückfall)" Tag="gdi"/>
                                    </ComboBox>
                                    <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="Messauflösung"/>
                                    <ComboBox x:Name="CaptureResBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4,0,4">
                                        <ComboBoxItem Content="niedrig (ca. 160 Pixel breit)" Tag="160"/>
                                        <ComboBoxItem Content="normal (ca. 320 Pixel breit)" Tag="320"/>
                                        <ComboBoxItem Content="hoch (ca. 640 Pixel breit)" Tag="640"/>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ Seite: Automatik (Zeitplan, Szenen) ============ -->
                <ScrollViewer x:Name="PageAuto" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="30,0,18,20">
                        <Border Style="{StaticResource Card}" Margin="0,0,12,14">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="Zeitplan"/>
                                <CheckBox x:Name="ScheduleBox" Content="Zeitplan verwenden"/>
                                <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,12"
                                           Text="In diesen Zeiten sind die LEDs aus oder laufen mit fester Helligkeit. Der Zeitplan geht den Regeln und der Betriebsart vor. Passen mehrere Zeilen, gilt die oberste. Ein Zeitfenster darf über Mitternacht gehen (z. B. 22:00 bis 07:00)."/>
                                <ListBox x:Name="ScheduleList"/>
                                <TextBlock x:Name="ScheduleEmpty" Style="{StaticResource Muted}" Text="Noch keine Zeitfenster."/>
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="56"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Label}" Text="Von" Margin="0,5,8,5"/>
                                    <TextBox x:Name="ScheduleFromBox" Grid.Column="1" Text="22:00"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource Label}" Text="bis" Margin="10,5,8,5"/>
                                    <TextBox x:Name="ScheduleToBox" Grid.Column="3" Text="07:00"/>
                                    <ComboBox x:Name="ScheduleActionBox" Grid.Column="4" SelectedIndex="0" Margin="10,0,0,0">
                                        <ComboBoxItem Content="LEDs aus" Tag="off"/>
                                        <ComboBoxItem Content="Helligkeit" Tag="brightness"/>
                                    </ComboBox>
                                    <Slider x:Name="ScheduleBrightSlider" Grid.Column="5" Minimum="0" Maximum="100" Value="30" Margin="12,0,0,0"/>
                                    <TextBlock x:Name="ScheduleBrightText" Grid.Column="6" Style="{StaticResource Value}"
                                               Text="{Binding Value, ElementName=ScheduleBrightSlider, StringFormat={}{0:0} %}"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button x:Name="ScheduleAddButton" Style="{StaticResource AccentButton}" Content="Als neue Zeile hinzufügen"/>
                                    <Button x:Name="ScheduleChangeButton" Content="Ausgewählte Zeile ändern" Margin="8,0,0,0"/>
                                    <Button x:Name="ScheduleRemoveButton" Content="Ausgewählte Zeile entfernen" Margin="8,0,0,0"/>
                                </StackPanel>
                                <TextBlock x:Name="ScheduleInfo" Style="{StaticResource Muted}" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,12,14">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="Szene: PC gesperrt"/>
                                <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12"
                                           Text="Gilt, solange der Sperrbildschirm zu sehen ist (Windows + L). Ohne Auswahl bleiben die LEDs aus."/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="56"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Style="{StaticResource Label}" Text="Dann"/>
                                    <ComboBox x:Name="LockModeBox" Grid.Column="1" SelectedIndex="0">
                                        <ComboBoxItem Content="LEDs aus" Tag="off"/>
                                        <ComboBoxItem Content="Feste Farbe" Tag="color"/>
                                        <ComboBoxItem Content="Effekt" Tag="effect"/>
                                    </ComboBox>
                                    <TextBlock x:Name="LockColorLabel" Grid.Row="1" Style="{StaticResource Label}" Text="Farbe" Margin="0,13,0,5"/>
                                    <DockPanel x:Name="LockColorPanel" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0">
                                        <Button x:Name="LockColorButton" DockPanel.Dock="Right" Content="Wählen" Margin="8,0,0,0"/>
                                        <Border x:Name="LockColorSwatch" DockPanel.Dock="Right" Width="36" CornerRadius="8" Margin="8,0,0,0" BorderBrush="{StaticResource Line2Brush}" BorderThickness="1"/>
                                        <TextBox x:Name="LockColorBox" Text="#FF6A00"/>
                                    </DockPanel>
                                    <TextBlock x:Name="LockEffectLabel" Grid.Row="2" Style="{StaticResource Label}" Text="Effekt" Margin="0,13,0,5"/>
                                    <ComboBox x:Name="LockEffectBox" Grid.Row="2" Grid.Column="1" Margin="0,8,0,0"/>
                                    <TextBlock x:Name="LockBrightLabel" Grid.Row="3" Style="{StaticResource Label}" Text="Helligkeit" Margin="0,13,0,5"/>
                                    <Slider x:Name="LockBrightSlider" Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="100" Value="30" Margin="0,8,0,0"/>
                                    <TextBlock x:Name="LockBrightText" Grid.Row="3" Grid.Column="2" Style="{StaticResource Value}" Margin="0,8,0,0"
                                               Text="{Binding Value, ElementName=LockBrightSlider, StringFormat={}{0:0} %}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,12,14">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="Szene: Ruhezustand oder Bildschirm aus"/>
                                <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12"
                                           Text="Gilt, wenn Windows den Bildschirm ausschaltet oder der PC schlafen geht. Ohne Auswahl bleiben die LEDs aus. Im echten Ruhezustand läuft das Programm nicht weiter: das Gerät hält dann das letzte Bild fest (ein Effekt bleibt also stehen). Dafür braucht es die Firmware v5.1 und einen USB-Anschluss, der im Ruhezustand weiter Strom liefert."/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="56"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Style="{StaticResource Label}" Text="Dann"/>
                                    <ComboBox x:Name="SleepModeBox" Grid.Column="1" SelectedIndex="0">
                                        <ComboBoxItem Content="LEDs aus" Tag="off"/>
                                        <ComboBoxItem Content="Feste Farbe" Tag="color"/>
                                        <ComboBoxItem Content="Effekt" Tag="effect"/>
                                    </ComboBox>
                                    <TextBlock x:Name="SleepColorLabel" Grid.Row="1" Style="{StaticResource Label}" Text="Farbe" Margin="0,13,0,5"/>
                                    <DockPanel x:Name="SleepColorPanel" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0">
                                        <Button x:Name="SleepColorButton" DockPanel.Dock="Right" Content="Wählen" Margin="8,0,0,0"/>
                                        <Border x:Name="SleepColorSwatch" DockPanel.Dock="Right" Width="36" CornerRadius="8" Margin="8,0,0,0" BorderBrush="{StaticResource Line2Brush}" BorderThickness="1"/>
                                        <TextBox x:Name="SleepColorBox" Text="#FF6A00"/>
                                    </DockPanel>
                                    <TextBlock x:Name="SleepEffectLabel" Grid.Row="2" Style="{StaticResource Label}" Text="Effekt" Margin="0,13,0,5"/>
                                    <ComboBox x:Name="SleepEffectBox" Grid.Row="2" Grid.Column="1" Margin="0,8,0,0"/>
                                    <TextBlock x:Name="SleepBrightLabel" Grid.Row="3" Style="{StaticResource Label}" Text="Helligkeit" Margin="0,13,0,5"/>
                                    <Slider x:Name="SleepBrightSlider" Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="100" Value="30" Margin="0,8,0,0"/>
                                    <TextBlock x:Name="SleepBrightText" Grid.Row="3" Grid.Column="2" Style="{StaticResource Value}" Margin="0,8,0,0"
                                               Text="{Binding Value, ElementName=SleepBrightSlider, StringFormat={}{0:0} %}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ Seite: Steuerung (Tastenkürzel, Stream Deck) ============ -->
                <ScrollViewer x:Name="PageControl" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="30,0,18,20">
                        <Border Style="{StaticResource Card}" Margin="0,0,12,14">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="Tastenkürzel"/>
                                <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12"
                                           Text="Gelten in jedem Programm, auch im Spiel. Feld anklicken und die Tasten drücken – mit Strg, Alt oder Win kombinieren; die Tasten F1 bis F24 gehen auch allein. Esc bricht ab. Standardmässig ist nichts belegt."/>
                                <StackPanel x:Name="HotkeyPanel"/>
                                <TextBlock x:Name="HotkeyInfo" Style="{StaticResource Muted}" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,12,14">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="Stream Deck und Kommandozeile"/>
                                <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12"
                                           Text="Im Stream Deck die Aktion «System › Öffnen» wählen und bei «App / Datei» eine der Zeilen eintragen. Läuft das Programm schon, führt es den Befehl sofort aus – es startet kein zweites Mal. Die gleichen Zeilen gehen auch in Verknüpfungen und Skripten. Am schnellsten reagiert ein Tastenkürzel: oben z. B. F13 bis F24 belegen (Feld anklicken, Stream-Deck-Taste drücken) und im Stream Deck «System › Hotkey» verwenden."/>
                                <TextBox x:Name="CommandBox" Style="{StaticResource CodeBox}" IsReadOnly="True" MinHeight="150"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button x:Name="CommandCopyButton" Content="Alle Zeilen kopieren"/>
                                    <Button x:Name="CommandEffectsButton" Content="Effekt-Kennungen kopieren" Margin="8,0,0,0"/>
                                </StackPanel>
                                <TextBlock x:Name="CommandInfo" Style="{StaticResource Muted}" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ Seite: Allgemein ============ -->
                <ScrollViewer x:Name="PageGeneral" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="30,0,18,20">
                        <Border Style="{StaticResource Card}" Margin="0,0,12,14">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="Programm"/>
                                <CheckBox x:Name="AutostartBox" Content="Mit Windows starten (im Infobereich, ohne Fenster)"/>
                                <CheckBox x:Name="UpdateBox" Content="Beim Start nach Updates suchen (offizielles GitHub)"/>
                                <Button x:Name="UpdateNowButton" Content="Jetzt nach Updates suchen" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                                <Button x:Name="SaveButton" Style="{StaticResource AccentButton}" Content="Einstellungen jetzt speichern" HorizontalAlignment="Left" Margin="0,14,0,0"/>
                                <TextBlock x:Name="SaveInfo" Style="{StaticResource Muted}" Margin="0,10,0,0"/>
                                <TextBlock x:Name="VersionInfo" Style="{StaticResource Muted}" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ================= Vorschau (ausklappbar) ================= -->
            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0">
                <DockPanel Margin="20,24,20,20">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource H2}" FontSize="18" Text="Vorschau"/>
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Muted}" Margin="0,12,0,0"
                               Text="Gestrichelt: gemessener Bereich. Weiss umrandet: LED 1. Ansicht von vorne."/>
                    <Border Background="{StaticResource BgBrush}" CornerRadius="10">
                        <Canvas x:Name="PreviewCanvas" ClipToBounds="True"/>
                    </Border>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
